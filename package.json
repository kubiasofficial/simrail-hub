{
  "name": "simrail-hub",
  "productName": "SimRail Hub",
  "version": "0.8.3",
  "description": "Komunitní launcher pro SimRail: The Railway Simulator",
  "author": "SimRail Hub",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "npm run build:main && node node_modules/electron/install.js && electron . --dev",
    "build:main": "node scripts/clean-main.mjs && tsc -p tsconfig.node.json && node scripts/bundle-preload.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --dir",
    "test:watch": "vitest",
    "prebuild:renderer": "node scripts/prepare-assets.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "predist": "node node_modules/electron/install.js",
    "dist:test": "npm run build && electron-builder --config build/test.config.cjs --win portable --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  },
  "homepage": "https://simrail-hub-kubias.web.app",
  "build": {
    "appId": "cz.simrailhub.launcher",
    "productName": "SimRail Hub",
    "copyright": "SimRail Hub – komunitní projekt, není spojen s vývojářem hry SimRail",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SimRail Hub",
      "uninstallDisplayName": "SimRail Hub",
      "deleteAppDataOnUninstall": false,
      "artifactName": "SimRail-Hub-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "SimRail-Hub-Portable-${version}.${ext}"
    },
    "compression": "normal",
    "electronDist": "node_modules/electron/dist",
    "publish": [
      {
        "provider": "github",
        "owner": "kubiasofficial",
        "repo": "simrail-hub",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "assets/recordings",
        "to": "recordings",
        "filter": [
          "*.wav",
          "manifest.json"
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kubiasofficial/simrail-hub.git"
  }
}
