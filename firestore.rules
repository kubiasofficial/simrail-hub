rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /public/{document} { allow read: if true; allow write: if false; }
    match /users/{uid}/settings/current {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['payload', 'updatedAt', 'schemaVersion'])
        && request.resource.data.payload is string && request.resource.data.payload.size() <= 10000
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedAt is timestamp;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
